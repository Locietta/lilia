{"t": 30, "uid": 2101, "name": "阿紫", "text": "国庆要不要一起去成都玩"}
{"t": 60, "uid": 2102, "name": "老王", "text": "可以啊，我一直想去吃火锅"}
{"t": 90, "uid": 2103, "name": "小林", "text": "我也去，几号出发"}
{"t": 120, "uid": 2101, "name": "阿紫", "text": "3号出发，玩四天吧"}
{"t": 150, "uid": 2104, "name": "阿杰", "text": "我只能请两天假，可能晚一天到"}
{"t": 180, "uid": 2102, "name": "老王", "text": "那酒店谁来订"}
{"t": 210, "uid": 2103, "name": "小林", "text": "我来订吧，我有会员"}
{"t": 240, "uid": 2101, "name": "阿紫", "text": "订春熙路附近的，方便逛"}
{"t": 270, "uid": 2102, "name": "老王", "text": "预算大概多少"}
{"t": 300, "uid": 2103, "name": "小林", "text": "一晚三百左右，两人一间"}
{"t": 330, "uid": 2104, "name": "阿杰", "text": "我跟老王一间"}
{"t": 360, "uid": 2101, "name": "阿紫", "text": "那我跟小林一间"}
{"t": 390, "uid": 2102, "name": "老王", "text": "高铁票谁抢"}
{"t": 420, "uid": 2101, "name": "阿紫", "text": "我来抢，到时候发群里"}
{"t": 450, "uid": 2103, "name": "小林", "text": "记得抢早上的"}
{"t": 480, "uid": 2104, "name": "阿杰", "text": "我晚一天，自己买"}
{"t": 510, "uid": 2102, "name": "老王", "text": "去熊猫基地吗"}
{"t": 540, "uid": 2101, "name": "阿紫", "text": "必须去，早上去熊猫比较精神"}
{"t": 570, "uid": 2103, "name": "小林", "text": "宽窄巷子也去一下"}
{"t": 600, "uid": 2104, "name": "阿杰", "text": "我想去看三星堆"}
{"t": 630, "uid": 2102, "name": "老王", "text": "三星堆在广汉，要单独去一天"}
{"t": 660, "uid": 2101, "name": "阿紫", "text": "那第三天去三星堆"}
{"t": 690, "uid": 2103, "name": "小林", "text": "火锅要吃哪家"}
{"t": 720, "uid": 2102, "name": "老王", "text": "我查了几家老火锅，到时候排队"}
{"t": 750, "uid": 2104, "name": "阿杰", "text": "我不太能吃辣"}
{"t": 780, "uid": 2101, "name": "阿紫", "text": "点鸳鸯锅就行"}
{"t": 810, "uid": 2103, "name": "小林", "text": "我对花生过敏，点菜注意一下"}
{"t": 840, "uid": 2102, "name": "老王", "text": "记住了"}
{"t": 870, "uid": 2101, "name": "阿紫", "text": "那就这么定了"}
{"t": 900, "uid": 2103, "name": "小林", "text": "我今晚就把酒店订了"}
{"t": 930, "uid": 2102, "name": "老王", "text": "钱先AA，回来再算"}
{"t": 960, "uid": 2104, "name": "阿杰", "text": "好的"}
{"t": 990, "uid": 2101, "name": "阿紫", "text": "要不要带相机"}
{"t": 1020, "uid": 2103, "name": "小林", "text": "我带"}
{"t": 1050, "uid": 2102, "name": "老王", "text": "充电宝也带上"}
{"t": 1080, "uid": 2104, "name": "阿杰", "text": "我建个行程文档"}
{"t": 1110, "uid": 2101, "name": "阿紫", "text": "好耶"}
{"t": 1140, "uid": 2102, "name": "老王", "text": "期待"}
{"t": 1170, "uid": 2103, "name": "小林", "text": "冲"}
{"t": 1200, "uid": 2104, "name": "阿杰", "text": "到时候见"}
{"t": 4240, "uid": 2102, "name": "老王", "text": "明天要下雨"}
{"t": 4280, "uid": 2103, "name": "小林", "text": "我的耳机坏了"}
{"t": 4320, "uid": 2104, "name": "阿杰", "text": "最近在玩肉鸽"}
{"t": 4360, "uid": 2102, "name": "老王", "text": "晚上吃啥"}
{"t": 4400, "uid": 2103, "name": "小林", "text": "好困啊"}
{"t": 4440, "uid": 2104, "name": "阿杰", "text": "这个视频好好笑"}
{"t": 4480, "uid": 2102, "name": "老王", "text": "楼下的猫又来了"}
{"t": 4520, "uid": 2103, "name": "小林", "text": "键盘到了手感不错"}
{"t": 4560, "uid": 2104, "name": "阿杰", "text": "又加班到九点"}
{"t": 4600, "uid": 2102, "name": "老王", "text": "周末想去爬山"}
{"t": 4640, "uid": 2103, "name": "小林", "text": "买的书到了"}
{"t": 4680, "uid": 2104, "name": "阿杰", "text": "游戏更新了好大"}
