// Copy to ~/.config/lilia/config.json. Comments are allowed; unknown keys are
// rejected so typos surface at startup (`lilia --check-config`).
{
  "onebot": {
    // NapCat's OneBot 11 websocket server, published on loopback only.
    "host": "127.0.0.1",
    "port": 3001,
    "access_token": "$LILIA_ONEBOT_TOKEN"
  },
  "model": {
    "base_url": "https://api.deepseek.com/anthropic",
    "model": "deepseek-flash",
    "api_key": "$DEEPSEEK_API_KEY",
    "max_tokens": 2048,
    // Decides whether and how she speaks (one tool call per turn).
    "planner_model": "deepseek-flash",
    "planner_max_tokens": 400,
    // Thinking makes replies slower; off sends thinking: {"type": "disabled"}.
    "thinking": false,
    "web_search": true
  },
  "chat": {
    // Only these groups are logged and answered.
    "groups": [],
    "private_users": [],
    "admins": [],
    "name": "莉莉娅",
    "aliases": ["lilia", "莉莉娅"],
    // How readily she joins conversations nobody addressed her in (0 = never).
    "talk_value": 0.3,
    "conversation_window_seconds": 300,
    "debounce_seconds": 3,
    "alt_style_probability": 0.15,
    "typing_speed": 1.0,
    "context_messages": 40,
    "context_bytes": 12000,
    "daily_token_budget": 2000000,
    "max_reply_bytes": 1500,
    "utc_offset_minutes": 480
  },
  "archive": {
    // Media of allowed chats is copied into <data_dir>/media and kept forever.
    "enabled": true,
    "max_file_bytes": 52428800,
    // NapCat's QQ data dir inside its container, and its host bind mount.
    "container_qq_dir": "/app/.config/QQ",
    "host_qq_dir": "~/services/napcat/qq"
  },
  "log_level": "info"
}
